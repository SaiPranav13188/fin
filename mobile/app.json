{
  "expo": {
    "name": "Fin",
    "slug": "fin",
    "version": "1.0.0",
    "scheme": "fin",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7FB",
    "android": {
      "package": "com.finsplit.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFE4F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "fin"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finsplit.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Fin turns what you say into an expense draft.",
        "NSMicrophoneUsageDescription": "Fin uses the microphone so you can say an expense instead of typing it."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7FB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Fin uses the microphone so you can say an expense instead of typing it.",
          "speechRecognitionPermission": "Fin turns what you say into an expense draft."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fin uses the camera to scan bills and UPI QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fin reads a bill photo you choose so it can split the items."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Fin uses biometrics to reveal your balance."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF6FB1"
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Balance",
              "label": "Fin balance",
              "description": "What you owe and what you are owed",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "*/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d4da4a99-b936-4a86-bcc0-ca1e1c288d8d"
      }
    },
    "owner": "sai_pranav1388"
  }
}